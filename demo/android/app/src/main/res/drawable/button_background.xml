<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:layout_width="wrap_content" android:layout_height="wrap_content" android:shape="rectangle">
            <solid android:color="#FFFFFF" />  <!-- White Background -->
            <corners android:radius="12dp" />  <!-- Rounded Corners -->
            <stroke android:width="2dp" android:color="#2E7D32" />  <!-- Green Border -->
            <size android:height="10dp" />  <!-- Adjust the height here -->
            <padding android:bottom="4dp" android:left="8dp" android:right="8dp" android:top="4dp" />
        </shape>
    </item>
</selector>
